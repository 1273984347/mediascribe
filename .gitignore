# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# Testing
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
# pytest tmp_path leftovers (pytest-cache-files-XXXX) and local test workspaces
pytest-cache-files-*/
test-ws-*/

# Logs
logs/
*.log
output/logs/

# Output files
# NOTE: `output/*` (not `output/`) so `!output/.gitkeep` can re-include —
# a fully-ignored directory makes negation patterns ineffective in git.
output/*
!output/.gitkeep

# Cache
.cache/
output/cache/
*.tmp

# Models (large files)
models/
*.bin
*.pt
*.pth
*.onnx

# OS
Thumbs.db
.DS_Store
$RECYCLE.BIN/

# Environment
.env
.env.local
.env.*.local

# Local config overrides
# config.json 是 config.example.json 的真实本地副本, 可能含 key —
# 不该被 `git add .` 吞进仓库(2026-10-03 审查加固)。
config.json
!config.example.json
config.local.json
my_config.json
*.local

# Cookies (sensitive)
cookies.txt
*.cookies

# One-click Web UI launcher state
.one-click.pid
.one-click.log
web-workspace/

# Archive (development history, not tracked)
archive/

# mkdocs build output (docs/ is the source; site/ is the artifact)
site/

# Agent local data (WorkBuddy memory/skills/identity — local only, not version-controlled)
.workbuddy/

# ---- AI 工具本地状态（勿入库·统一模板 2026-10-30）----
.mimosa/
.codebuddy/
.writerHelper/
.trae/*
!.trae/skills/
.zcode/

# ---- 内部产物与私有内容（2026-10-31 公开/私有内容分离，严禁入库）----
# 内部开发报告 / 执行记录（公开仓库只保留面向用户的产品文档）
docs/reports/
# CLI help 快照是 capture_cli_help.py 的测试输出产物，需要时本地重生成
docs/cli-screenshots/
# 基准测试输出产物（results.json 由 bench 脚本落盘，属本机运行数据）
scripts/bench/*/results.json
# 发布说明草稿在打 tag 时创建即可，不留正式分支
GITHUB_RELEASE_*.md
