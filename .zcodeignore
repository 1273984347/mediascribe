# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store

# Testing
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
# pytest tmp_path leftovers (pytest-cache-files-XXXX) and local test workspaces
pytest-cache-files-*/
test-ws-*/

# Logs
logs/
*.log
output/logs/

# Output files
# NOTE: `output/*` (not `output/`) so `!output/.gitkeep` can re-include —
# a fully-ignored directory makes negation patterns ineffective in git.
output/*
!output/.gitkeep

# Cache
.cache/
output/cache/
*.tmp

# Models (large files)
models/
*.bin
*.pt
*.pth
*.onnx

# OS
Thumbs.db
.DS_Store
$RECYCLE.BIN/

# Environment
.env
.env.local
.env.*.local

# Local config overrides
# config.json 是 config.example.json 的真实本地副本, 可能含 key —
# 不该被 `git add .` 吞进仓库(2026-10-03 审查加固)。
config.json
!config.example.json
config.local.json
my_config.json
*.local

# Cookies (sensitive)
cookies.txt
*.cookies

# One-click Web UI launcher state
.one-click.pid
.one-click.log
web-workspace/

# Archive (development history, not tracked)
archive/

# Agent local data (WorkBuddy memory/skills/identity — local only, not version-controlled)
.workbuddy/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
